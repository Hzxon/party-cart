.game-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.game-overlay Label { margin: 0; padding: 0; }
.game-modal { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(10,34,40,0.65); align-items: center; justify-content: center; display: none; }
.overlay-paper { background-color: rgb(246,243,231); border-width: 4px; border-color: rgb(21,63,71); border-radius: 8px; padding: 35px 42px; flex-shrink: 0; color: rgb(21,63,71); }
.pause-paper { width: 560px; }
.paper-wordmark { -unity-text-align: middle-center; font-size: 27px; letter-spacing: 2px; }
.overlay-title { font-size: 110px; -unity-text-align: middle-center; margin-top: 6px; margin-bottom: 22px; }
.overlay-button { font-size: 40px; min-height: 78px; height: 78px; margin-bottom: 12px; -unity-text-align: middle-center; }
.text-button { border-width: 0; border-radius: 0; background-color: rgba(0,0,0,0); color: rgb(21,63,71); font-size: 23px; min-height: 58px; margin: 0; padding: 8px 12px; }
.text-button:hover, .text-button:focus { background-color: rgb(225,232,215); }
.keyboard-hint { -unity-text-align: middle-center; font-size: 20px; margin-top: 16px; opacity: 0.7; }
.settings-paper { width: 850px; }
.settings-title { font-size: 88px; margin-bottom: 16px; }
.options-tabs { flex-direction: row; justify-content: center; border-bottom-width: 2px; border-bottom-color: rgb(21,63,71); margin-bottom: 26px; }
.options-tab { width: 195px; height: 58px; background-color: rgba(0,0,0,0); color: rgb(113,126,124); border-width: 0; border-radius: 0; border-bottom-width: 5px; border-bottom-color: rgba(0,0,0,0); font-size: 26px; margin: 0; }
.options-tab.is-selected { color: rgb(21,63,71); border-bottom-color: rgb(21,63,71); background-color: rgb(233,240,89); }
.options-tab:hover { color: rgb(21,63,71); }
.options-content { min-height: 230px; justify-content: center; }
.setting-row { flex-direction: row; align-items: center; min-height: 75px; }
.setting-label { width: 218px; font-size: 23px; flex-shrink: 0; }
.setting-value { width: 76px; -unity-text-align: middle-right; font-size: 22px; }
.volume-slider { flex-grow: 1; margin: 0 12px 0 0; height: 46px; }
.volume-slider .unity-base-slider__tracker { height: 10px; background-color: rgb(21,63,71); border-radius: 3px; }
.volume-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(233,240,89); border-width: 1px; border-color: rgb(21,63,71); border-radius: 2px; }
.volume-slider .unity-base-slider__dragger { width: 21px; height: 31px; margin-top: -10px; background-color: rgb(233,240,89); border-width: 3px; border-color: rgb(21,63,71); border-radius: 1px; }
.volume-slider .unity-base-slider__dragger-border { border-width: 0; }
.setting-dropdown { flex-grow: 1; min-width: 260px; margin: 0; }
.setting-dropdown > .unity-base-field__input { background-color: rgb(246,243,231); border-width: 2px; border-color: rgb(21,63,71); border-radius: 0; min-height: 51px; color: rgb(21,63,71); font-size: 25px; padding: 8px 15px; }
.setting-dropdown:focus > .unity-base-field__input { border-color: rgb(232,108,74); }
.fullscreen-toggle { font-size: 24px; }
.fullscreen-toggle .unity-toggle__checkmark { width: 31px; height: 31px; background-color: rgb(246,243,231); border-width: 2px; border-color: rgb(21,63,71); }
.fullscreen-toggle:checked .unity-toggle__checkmark { background-color: rgb(233,240,89); }
.options-status { white-space: normal; font-size: 18px; min-height: 37px; margin-top: 18px; }
.options-footer { flex-direction: row; justify-content: space-between; align-items: center; border-top-width: 2px; border-top-color: rgb(21,63,71); padding-top: 24px; margin-top: 10px; }
.save-button { width: 214px; min-height: 72px; font-size: 36px; -unity-text-align: middle-center; }
.confirm-paper { width: 740px; }
.confirm-title { font-size: 77px; margin-bottom: 15px; }
.confirm-message { white-space: normal; -unity-text-align: middle-center; font-size: 26px; min-height: 90px; margin-top: 10px; margin-bottom: 22px; }
.confirm-buttons { flex-direction: row; justify-content: space-between; }
.confirm-buttons Button { width: 47%; -unity-text-align: middle-center; }
.wrong-way { position: absolute; top: 68px; left: 50%; translate: -50% 0; flex-direction: row; align-items: center; padding: 15px 26px; border-width: 4px; border-color: rgb(21,63,71); border-top-color: rgb(232,108,74); background-color: rgb(246,243,231); display: none; }
.wrong-icon { color: rgb(232,108,74); font-size: 66px; margin-right: 19px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(21,63,71); }
.warning-title { font-size: 48px; }.warning-detail { font-size: 22px; }
.reset-prompt { position: absolute; bottom: 32px; left: 50%; translate: -50% 0; width: 420px; display: none; }
.reset-caption { color: rgb(246,243,231); font-size: 20px; -unity-text-align: middle-center; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(21,63,71); margin-bottom: 10px; white-space: normal; }
.reset-ticket { flex-direction: row; align-items: center; padding: 13px 17px; border-width: 3px; border-color: rgb(21,63,71); border-radius: 4px; background-color: rgb(246,243,231); }
.keycap { width: 49px; height: 49px; background-color: rgb(21,63,71); color: rgb(246,243,231); -unity-text-align: middle-center; font-size: 28px; border-radius: 3px; margin-right: 19px; flex-shrink: 0; }
.reset-info { flex-grow: 1; }.reset-title { font-size: 30px; -unity-text-align: middle-center; }
.reset-track { height: 11px; border-width: 2px; border-color: rgb(21,63,71); background-color: rgb(21,63,71); border-radius: 3px; margin-top: 6px; overflow: hidden; }
.reset-fill { width: 0; height: 100%; background-color: rgb(233,240,89); }
.drift-hud { position: absolute; bottom: 38px; left: 50%; translate: -50% 0; width: 340px; background-color: rgb(246,243,231); color: rgb(21,63,71); border-width: 3px; border-color: rgb(21,63,71); padding: 9px 15px 13px 15px; display: none; }
.drift-heading { flex-direction: row; align-items: center; justify-content: space-between; }
.drift-title { font-size: 34px; }
.drift-hint { font-size: 16px; }
.drift-track { height: 9px; background-color: rgb(21,63,71); margin-top: 4px; overflow: hidden; }
.drift-fill { height: 100%; width: 0; background-color: rgb(97,198,198); }
.drift-hud.is-ready { background-color: rgb(233,240,89); }
.is-ready .drift-fill { background-color: rgb(232,108,74); }
