.lap-hud {
    position: absolute;
    top: 28px;
    right: 30px;
    width: 100%;
    height: 100%;
    align-items: flex-end;
}

.lap-panel {
    position: absolute;
    top: 0;
    right: 0;
    min-width: 188px;
    height: 66px;
    flex-direction: row;
    align-items: center;
    padding-left: 17px;
    padding-right: 18px;
    background-color: #F45C78;
    border-top-width: 2px;
    border-top-color: #FF9BA9;
    border-left-width: 2px;
    border-left-color: #FF9BA9;
    border-right-width: 2px;
    border-right-color: #B52D50;
    border-bottom-width: 5px;
    border-bottom-color: #B52D50;
    border-top-left-radius: 12px;
    border-top-right-radius: 19px;
    border-bottom-left-radius: 19px;
    border-bottom-right-radius: 12px;
}

.lap-swipe {
    position: absolute;
    height: 5px;
    border-radius: 3px;
}

.lap-swipe-back {
    left: -7px;
    top: 12px;
    width: 30px;
    background-color: #FFC840;
}

.lap-swipe-front {
    right: 13px;
    bottom: 7px;
    width: 34px;
    background-color: #FF8D9B;
}

.lap-caption {
    margin-right: 9px;
    color: #FFF5E9;
    font-size: 16px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
    -unity-text-outline-color: #7F243D;
    -unity-text-outline-width: 1px;
}

.lap-value {
    color: #FFFFFF;
    font-size: 32px;
    -unity-font-style: bold-and-italic;
    -unity-text-align: middle-left;
    -unity-text-outline-color: #7F243D;
    -unity-text-outline-width: 1.5px;
}
